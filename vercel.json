{
  "version": 2,
  "rewrites": [
    { "source": "/menu.json", "destination": "/api/menu" },
    { "source": "/channels.json", "destination": "/api/channels" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
